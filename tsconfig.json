{
  // App-only program: Jest/Node ambient globals live in tsconfig.test.json instead, so a
  // screen can't reference __dirname or node:fs and still typecheck as if that were fine.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    // [] — React/Expo types arrive via imports and the triple-slash reference in
    // expo-env.d.ts, not ambient @types, so none need listing here.
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Setting "exclude" here replaces (not merges with) expo/tsconfig.base's own exclude,
  // so its entries are repeated below; test files are added since they live in tsconfig.test.json.
  // testDb.ts is excluded too: it imports better-sqlite3, which has no place in the app program.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "src/db/testDb.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}