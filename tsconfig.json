{
  // App-only program: Jest/Node ambient globals live in tsconfig.test.json instead, so a
  // screen can't reference __dirname or node:fs and still typecheck as if that were fine.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // strict alone still lets `array[i]` claim a non-undefined element, which is
    // exactly the read M1b's dive list and drag-to-reorder are built out of
    // (items[i - 1], items[i + 1], splice-and-reinsert). An index-0 access that
    // threw already got through this branch once and was found by executing the
    // code, not by the compiler. Turned on before M1b writes that code rather
    // than after. No suppression comments: if a read is safe, make the safety
    // visible in the types or narrow it explicitly.
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    // [] — React/Expo types arrive via imports and the triple-slash reference in
    // expo-env.d.ts, not ambient @types, so none need listing here.
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Setting "exclude" here replaces (not merges with) expo/tsconfig.base's own exclude,
  // so its entries are repeated below; test files are added since they live in tsconfig.test.json.
  // testDb.ts is excluded too: it imports better-sqlite3, which has no place in the app program.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "src/db/testDb.ts",
    "src/testing/unexpectedGraphics.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}