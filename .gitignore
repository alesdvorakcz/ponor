# macOS
.DS_Store

# secrets
.env
.env.*
# ...except the template, which holds no values and documents which key may ever go in one.
# `.env.*` matches `.env.example` too, so without this negation the file that warns against
# committing the service_role key is itself the one file git refuses to keep.
!.env.example

# dependencies & build output (Expo scaffold will extend this in M0)
node_modules/

# subagent-driven-development scratch
.superpowers/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native projects (generated by prebuild)
/ios
/android

# misc
*.log
.metro-health-check*
