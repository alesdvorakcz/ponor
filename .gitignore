# macOS
.DS_Store

# secrets
.env
.env.*
# ...except the template, which holds no values and documents which key may ever go in one.
# `.env.*` matches `.env.example` too, so without this negation the file that warns against
# committing the service_role key is itself the one file git refuses to keep.
!.env.example

# dependencies & build output (Expo scaffold will extend this in M0)
node_modules/

# subagent-driven-development scratch
.superpowers/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native projects (generated by prebuild)
/ios
/android

# dive computer exports
# A real Suunto export carries the computer's serial in `DeviceLog.Device.SerialNumber`, and a
# transmitter's id in every sample that had one. `.fit` is never a legitimate file in this tree,
# and the two drop folders give a real export somewhere to sit inside the repo — for a test run,
# or to hand to the importer — without being committable.
#
# **What this cannot catch is the way it actually went wrong** (M3o): the two committed fixtures
# ARE real exports, trimmed to six samples. Trimming cut the samples and left the header, so a
# serial rode along into git and was only redacted three commits later. A file deliberately added
# under `__fixtures__/` is a file no ignore rule will ever stop — anonymise the header by hand,
# and check it before committing.
*.fit
/exports/
/private/

# misc
*.log
.metro-health-check*
